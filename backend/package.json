    "seed": "ts-node scripts/seed.ts",
    "import-players": "ts-node scripts/simple-import.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.32.1",
    "sqlite3": "^5.1.6",
