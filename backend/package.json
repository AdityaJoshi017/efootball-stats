{
  "name": "efootball-stats-backend",
  "version": "0.1.0",
  "description": "Backend API for efootball-stats player data management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
